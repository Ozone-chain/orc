# ==============================================================================
# Ozone Chain Deployment Environment Variables
# ==============================================================================

# Deployer Private Key (hex format without 0x prefix, or with 0x)
PRIVATE_KEY=your_private_key_here

# Ozone Chain Network RPCs
# Testnet RPC:
OZONE_TESTNET_RPC=https://node1.ozonechain.io
# Mainnet RPC:
OZONE_MAINNET_RPC=https://node1.ozonechain.io

# Active RPC URL (switch between Testnet and Mainnet)
OZONE_RPC_URL=https://node1.ozonechain.io

# Token Configuration Parameters
TOKEN_NAME="Ozone Reference Token"
TOKEN_SYMBOL="ORC"
TOKEN_INITIAL_SUPPLY=1000000000000000000000000 # 1,000,000 * 10^18

# Ozone Block Explorer API / Verifier URL (for contract verification)
OZONE_EXPLORER_URL=https://ozonescan.io/api
