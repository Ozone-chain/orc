{
  "name": "orc-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Ozone Request for Comments (ORC) standards repository and official developer packages",
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "build": "npm --prefix packages/orc run build",
    "test": "npm run build && npm --prefix packages/orc test",
    "build:contracts": "forge build",
    "test:contracts": "forge test",
    "test:compliance": "forge test --match-contract ORC20ComplianceTest -vv",
    "test:benchmark": "forge test --match-contract ORC20BenchmarkTest --gas-report"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ozone-chain/orc.git"
  },
  "keywords": [
    "ozone",
    "ozone-chain",
    "orc",
    "orc-20",
    "erc-20",
    "smart-contracts",
    "solidity",
    "evm",
    "standards"
  ],
  "author": "Ozone Chain Core Architecture Team <standards@ozonechain.io>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ozone-chain/orc/issues"
  },
  "homepage": "https://ozonechain.io"
}
